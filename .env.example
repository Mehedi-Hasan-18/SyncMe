# Copy this file to `.env` and fill in the values. Never commit `.env`.
# The same variables must also be set in Vercel → Project → Settings → Environment Variables,
# because Vercel builds in its own environment and never sees your local `.env`.

# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon key. EITHER of these works (new projects issue the publishable format):
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Never use the service_role key here — every VITE_ value is bundled into client JS and is public.

# ICE relay (free defaults; override later to swap providers without a rewrite)
VITE_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject

# PeerJS signaling. Leave empty to use the free PeerJS cloud (default for the MVP).
# Set these only when self-hosting the `peer` server later.
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_KEY=
VITE_PEER_SECURE=
